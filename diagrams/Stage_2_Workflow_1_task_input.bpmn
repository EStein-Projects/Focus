<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WF1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_WF1">
    <bpmn:participant id="Participant_TaskInputter" name="Task Inputter" processRef="Process_TaskInputter" />
    <bpmn:participant id="Participant_TaskInputAPI" name="Task Input API Handler" processRef="Process_TaskInputAPI" />
    <bpmn:participant id="Participant_TaskDB" name="Task Database" processRef="Process_TaskDB" />
    <bpmn:participant id="Participant_DepGraph" name="Task Dependency Graph" processRef="Process_DepGraph" />
    <bpmn:participant id="Participant_DepHandler" name="Dependency Handler" processRef="Process_DepHandler" />
    <bpmn:messageFlow id="MsgFlow_1" name="View Tasks Request" sourceRef="Task_RequestView" targetRef="Event_ReceiveViewReq" />
    <bpmn:messageFlow id="MsgFlow_2" name="Current Tasks and Dependencies" sourceRef="Task_ReturnTasksToInputter" targetRef="Event_ReceiveTasks" />
    <bpmn:messageFlow id="MsgFlow_3" name="SQL Query" sourceRef="Task_QueryTaskDB" targetRef="Event_DBReceiveQuery" />
    <bpmn:messageFlow id="MsgFlow_4" name="Task Data" sourceRef="Task_DBReturnData" targetRef="Event_ReceiveDBData" />
    <bpmn:messageFlow id="MsgFlow_5" name="New Task Data" sourceRef="Task_SubmitNewData" targetRef="Event_ReceiveNewData" />
    <bpmn:messageFlow id="MsgFlow_6" name="New Task" sourceRef="Task_WriteNewTask" targetRef="Event_DBReceiveWrite" />
    <bpmn:messageFlow id="MsgFlow_7" name="Write Confirmation" sourceRef="Task_DBAckWrite" targetRef="Event_ReceiveWriteAck" />
    <bpmn:messageFlow id="MsgFlow_9" name="Submission Confirmation" sourceRef="Task_SendConfirmation" targetRef="Event_ReceiveConfirmation" />
    <bpmn:messageFlow id="MsgFlow_QueryDep" name="Query Dependencies" sourceRef="Task_QueryDepGraph" targetRef="Event_DepReceiveQuery" />
    <bpmn:messageFlow id="MsgFlow_ReturnDep" name="Dependency Data" sourceRef="Task_DepReturnData" targetRef="Event_ReceiveDepData" />
    <bpmn:messageFlow id="MsgFlow_PollDB" name="Poll for Unprocessed Dependency Writes" sourceRef="Task_PollTaskDB" targetRef="Event_DBReceivePoll" />
    <bpmn:messageFlow id="MsgFlow_PollResult" name="Unprocessed Dependency Data" sourceRef="Task_DBReturnPollData" targetRef="Event_ReceivePollResult" />
    <bpmn:messageFlow id="MsgFlow_DepUpdate" name="Dependency Updates" sourceRef="Task_WriteDepUpdates" targetRef="Event_DepReceiveUpdate" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TaskInputter" isExecutable="false">
    <bpmn:startEvent id="Start_Inputter" name="Task Inputter wants to submit data">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_RequestView" name="Request to view current tasks">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveTasks" name="Receive current tasks">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ReviewAndPrepare" name="Review current tasks and prepare new data">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SubmitNewData" name="Submit new task data">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveConfirmation" name="Receive confirmation">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Inputter" name="Data submitted successfully">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Inputter" targetRef="Task_RequestView" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_RequestView" targetRef="Event_ReceiveTasks" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Event_ReceiveTasks" targetRef="Task_ReviewAndPrepare" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ReviewAndPrepare" targetRef="Task_SubmitNewData" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_SubmitNewData" targetRef="Event_ReceiveConfirmation" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Event_ReceiveConfirmation" targetRef="End_Inputter" />
  </bpmn:process>
  <bpmn:process id="Process_TaskInputAPI" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_A8" sourceRef="Task_SendConfirmation" targetRef="End_API" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Event_ReceiveWriteAck" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_A6" sourceRef="Task_WriteNewTask" targetRef="Event_ReceiveWriteAck" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Event_ReceiveNewData" targetRef="Task_WriteNewTask" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_ReturnTasksToInputter" targetRef="Event_ReceiveNewData" />
    <bpmn:sequenceFlow id="Flow_A3c" sourceRef="Event_ReceiveDepData" targetRef="Task_ReturnTasksToInputter" />
    <bpmn:sequenceFlow id="Flow_A3b" sourceRef="Task_QueryDepGraph" targetRef="Event_ReceiveDepData" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Event_ReceiveDBData" targetRef="Task_QueryDepGraph" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_QueryTaskDB" targetRef="Event_ReceiveDBData" />
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Event_ReceiveViewReq" targetRef="Task_QueryTaskDB" />
    <bpmn:endEvent id="End_API" name="Request handled">
      <bpmn:incoming>Flow_A8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send confirmation to Task Inputter">
      <bpmn:incoming>Flow_A7</bpmn:incoming>
      <bpmn:outgoing>Flow_A8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveWriteAck" name="Receive write confirmation">
      <bpmn:incoming>Flow_A6</bpmn:incoming>
      <bpmn:outgoing>Flow_A7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_6" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_WriteNewTask" name="Add new data to Task Database">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
      <bpmn:outgoing>Flow_A6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveNewData" name="Receive new task data">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ReturnTasksToInputter" name="Return current tasks and dependencies to Task Inputter">
      <bpmn:incoming>Flow_A3c</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveDepData" name="Receive dependency data">
      <bpmn:incoming>Flow_A3b</bpmn:incoming>
      <bpmn:outgoing>Flow_A3c</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DepData" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_QueryDepGraph" name="Query Task Dependency Graph for current dependencies">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_A3b</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveDBData" name="Receive task data from DB">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_4" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_QueryTaskDB" name="Query Task Database for current tasks">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:startEvent id="Event_ReceiveViewReq" name="Receive view request">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_3" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_TaskDB" isExecutable="false">
    <bpmn:startEvent id="Event_DBReceiveQuery" name="Receive query">
      <bpmn:outgoing>Flow_DB1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_7" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ExecuteQuery" name="Execute SQL query">
      <bpmn:incoming>Flow_DB1</bpmn:incoming>
      <bpmn:outgoing>Flow_DB2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_DBReturnData" name="Return task data">
      <bpmn:incoming>Flow_DB2</bpmn:incoming>
      <bpmn:outgoing>Flow_DB3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_DBReceiveWrite" name="Receive write request">
      <bpmn:incoming>Flow_DB3</bpmn:incoming>
      <bpmn:outgoing>Flow_DB4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_8" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ExecuteWrite" name="Write new task data">
      <bpmn:incoming>Flow_DB4</bpmn:incoming>
      <bpmn:outgoing>Flow_DB5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_DBAckWrite" name="Send write confirmation">
      <bpmn:incoming>Flow_DB5</bpmn:incoming>
      <bpmn:outgoing>Flow_DB6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_DB" name="Data stored">
      <bpmn:incoming>Flow_DB6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_DB1" sourceRef="Event_DBReceiveQuery" targetRef="Task_ExecuteQuery" />
    <bpmn:sequenceFlow id="Flow_DB2" sourceRef="Task_ExecuteQuery" targetRef="Task_DBReturnData" />
    <bpmn:sequenceFlow id="Flow_DB3" sourceRef="Task_DBReturnData" targetRef="Event_DBReceiveWrite" />
    <bpmn:sequenceFlow id="Flow_DB4" sourceRef="Event_DBReceiveWrite" targetRef="Task_ExecuteWrite" />
    <bpmn:sequenceFlow id="Flow_DB5" sourceRef="Task_ExecuteWrite" targetRef="Task_DBAckWrite" />
    <bpmn:sequenceFlow id="Flow_DB6" sourceRef="Task_DBAckWrite" targetRef="End_DB" />
    <bpmn:startEvent id="Event_DBReceivePoll" name="Receive poll for unprocessed dependency writes">
      <bpmn:outgoing>Flow_DB_Poll1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Poll" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ExecutePoll" name="Query for unprocessed dependency data">
      <bpmn:incoming>Flow_DB_Poll1</bpmn:incoming>
      <bpmn:outgoing>Flow_DB_Poll2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_DBReturnPollData" name="Return unprocessed dependency data">
      <bpmn:incoming>Flow_DB_Poll2</bpmn:incoming>
      <bpmn:outgoing>Flow_DB_End3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_DB_Poll1" sourceRef="Event_DBReceivePoll" targetRef="Task_ExecutePoll" />
    <bpmn:sequenceFlow id="Flow_DB_Poll2" sourceRef="Task_ExecutePoll" targetRef="Task_DBReturnPollData" />
    <bpmn:sequenceFlow id="Flow_DB_End3" sourceRef="Task_DBReturnPollData" targetRef="End_DB_Poll" />
    <bpmn:endEvent id="End_DB_Poll" name="Poll complete">
      <bpmn:incoming>Flow_DB_End3</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_DepGraph" isExecutable="false">
    <bpmn:startEvent id="Event_DepReceiveQuery" name="Receive dependency query">
      <bpmn:outgoing>Flow_DG1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DG1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ComputeDeps" name="Retrieve current dependency data">
      <bpmn:incoming>Flow_DG1</bpmn:incoming>
      <bpmn:outgoing>Flow_DG2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_DepReturnData" name="Return dependency data">
      <bpmn:incoming>Flow_DG2</bpmn:incoming>
      <bpmn:outgoing>Flow_DG_End1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_DepGraph_Query" name="Query answered">
      <bpmn:incoming>Flow_DG_End1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_DG1" sourceRef="Event_DepReceiveQuery" targetRef="Task_ComputeDeps" />
    <bpmn:sequenceFlow id="Flow_DG2" sourceRef="Task_ComputeDeps" targetRef="Task_DepReturnData" />
    <bpmn:sequenceFlow id="Flow_DG_End1" sourceRef="Task_DepReturnData" targetRef="End_DepGraph_Query" />
    <bpmn:sequenceFlow id="Flow_DG3" sourceRef="Event_DepReceiveUpdate" targetRef="Task_UpdateGraph" />
    <bpmn:sequenceFlow id="Flow_DG_End2" sourceRef="Task_UpdateGraph" targetRef="End_DepGraph_Update" />
    <bpmn:serviceTask id="Task_UpdateGraph" name="Apply dependency updates to graph">
      <bpmn:incoming>Flow_DG3</bpmn:incoming>
      <bpmn:outgoing>Flow_DG_End2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DepGraph_Update" name="Graph updated">
      <bpmn:incoming>Flow_DG_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_DepReceiveUpdate" name="Receive dependency updates">
      <bpmn:outgoing>Flow_DG3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DG2" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_DepHandler" isExecutable="false">
    <bpmn:startEvent id="Start_DepHandler" name="Polling cycle begins">
      <bpmn:outgoing>Flow_DH1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_PollTaskDB" name="Poll Task Database for unprocessed dependency writes">
      <bpmn:incoming>Flow_DH1</bpmn:incoming>
      <bpmn:incoming>Flow_DH_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_DH2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceivePollResult" name="Receive unprocessed dependency data">
      <bpmn:incoming>Flow_DH2</bpmn:incoming>
      <bpmn:outgoing>Flow_DH3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DH1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_HasUpdates" name="New dependency data found?">
      <bpmn:incoming>Flow_DH3</bpmn:incoming>
      <bpmn:outgoing>Flow_DH_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DH_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_DHMerge" name="">
      <bpmn:incoming>Flow_DH4</bpmn:incoming>
      <bpmn:incoming>Flow_DH_No</bpmn:incoming>
      <bpmn:outgoing>Flow_DH5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_PollWait" name="Wait for next polling interval">
      <bpmn:incoming>Flow_DH5</bpmn:incoming>
      <bpmn:outgoing>Flow_DH_Loop</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_DH" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_DH1" sourceRef="Start_DepHandler" targetRef="Task_PollTaskDB" />
    <bpmn:sequenceFlow id="Flow_DH_Loop" sourceRef="Event_PollWait" targetRef="Task_PollTaskDB" />
    <bpmn:sequenceFlow id="Flow_DH2" sourceRef="Task_PollTaskDB" targetRef="Event_ReceivePollResult" />
    <bpmn:sequenceFlow id="Flow_DH3" sourceRef="Event_ReceivePollResult" targetRef="Gateway_HasUpdates" />
    <bpmn:sequenceFlow id="Flow_DH_Yes" name="Yes" sourceRef="Gateway_HasUpdates" targetRef="Task_WriteDepUpdates" />
    <bpmn:sequenceFlow id="Flow_DH_No" name="No" sourceRef="Gateway_HasUpdates" targetRef="Gateway_DHMerge" />
    <bpmn:sequenceFlow id="Flow_DH4" sourceRef="Task_WriteDepUpdates" targetRef="Gateway_DHMerge" />
    <bpmn:sequenceFlow id="Flow_DH5" sourceRef="Gateway_DHMerge" targetRef="Event_PollWait" />
    <bpmn:sendTask id="Task_WriteDepUpdates" name="Write dependency updates to Task Dependency Graph">
      <bpmn:incoming>Flow_DH_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_DH4</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_WF1">
    <bpmndi:BPMNPlane id="BPMNPlane_WF1" bpmnElement="Collaboration_WF1">
      <bpmndi:BPMNShape id="Shape_P_Inputter" bpmnElement="Participant_TaskInputter" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1300" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S1" bpmnElement="Start_Inputter">
        <dc:Bounds x="222" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S2" bpmnElement="Task_RequestView">
        <dc:Bounds x="300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S3" bpmnElement="Event_ReceiveTasks">
        <dc:Bounds x="442" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S4" bpmnElement="Task_ReviewAndPrepare">
        <dc:Bounds x="520" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S5" bpmnElement="Task_SubmitNewData">
        <dc:Bounds x="670" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S6" bpmnElement="Event_ReceiveConfirmation">
        <dc:Bounds x="822" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="809" y="84.5" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S7" bpmnElement="End_Inputter">
        <dc:Bounds x="902" y="122" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E1" bpmnElement="Flow_1">
        <di:waypoint x="258" y="140" />
        <di:waypoint x="300" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E2" bpmnElement="Flow_2">
        <di:waypoint x="400" y="140" />
        <di:waypoint x="442" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E3" bpmnElement="Flow_3">
        <di:waypoint x="478" y="140" />
        <di:waypoint x="520" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E4" bpmnElement="Flow_4">
        <di:waypoint x="620" y="140" />
        <di:waypoint x="670" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E5" bpmnElement="Flow_5">
        <di:waypoint x="770" y="140" />
        <di:waypoint x="822" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E6" bpmnElement="Flow_6">
        <di:waypoint x="858" y="140" />
        <di:waypoint x="902" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Shape_P_API" bpmnElement="Participant_TaskInputAPI" isHorizontal="true">
        <dc:Bounds x="160" y="280" width="1300" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA1" bpmnElement="Event_ReceiveViewReq">
        <dc:Bounds x="222" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="207" y="408" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA2" bpmnElement="Task_QueryTaskDB">
        <dc:Bounds x="300" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA3" bpmnElement="Event_ReceiveDBData">
        <dc:Bounds x="442" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="416" y="408" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA3b" bpmnElement="Task_QueryDepGraph">
        <dc:Bounds x="520" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA3c" bpmnElement="Event_ReceiveDepData">
        <dc:Bounds x="662" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="638" y="408" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA4" bpmnElement="Task_ReturnTasksToInputter">
        <dc:Bounds x="740" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA5" bpmnElement="Event_ReceiveNewData">
        <dc:Bounds x="882" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="856" y="408" width="88" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA6" bpmnElement="Task_WriteNewTask">
        <dc:Bounds x="960" y="350" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA7" bpmnElement="Event_ReceiveWriteAck">
        <dc:Bounds x="1102" y="372" width="36" height="36" />
        <bpmndi:BPMNLabel>
