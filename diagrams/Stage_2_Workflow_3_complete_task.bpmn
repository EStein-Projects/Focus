<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WF3" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_WF3">
    <bpmn:participant id="Participant_Worker" name="Worker" processRef="Process_Worker" />
    <bpmn:participant id="Participant_WorkerAPI" name="Worker API Handler" processRef="Process_WorkerAPI" />
    <bpmn:participant id="Participant_WorkerDB" name="Worker Database" processRef="Process_WorkerDB" />
    <bpmn:participant id="Participant_TaskDB" name="Task Database" processRef="Process_TaskDB" />
    <bpmn:participant id="Participant_DepGraph" name="Task Dependency Graph" processRef="Process_DepGraph" />
    <bpmn:participant id="Participant_DepHandler" name="Dependency Handler" processRef="Process_DepHandler" />
    <bpmn:messageFlow id="MF_CompletionReq" name="Task Completion Request (with Task ID)" sourceRef="Task_RequestCompletion" targetRef="Start_API" />
    <bpmn:messageFlow id="MF_VerifyState" name="Verify Worker State and Assignment" sourceRef="Task_VerifyWorker" targetRef="Start_WDB" />
    <bpmn:messageFlow id="MF_ReturnVerify" name="Verification Result" sourceRef="Task_ReturnVerification" targetRef="Event_ReceiveVerify" />
    <bpmn:messageFlow id="MF_MarkComplete" name="Mark Task as Completed" sourceRef="Task_MarkComplete" targetRef="Start_TDB" />
    <bpmn:messageFlow id="MF_MarkAck" name="Completion Acknowledged" sourceRef="Task_AckCompletion" targetRef="Event_ReceiveMarkAck" />
    <bpmn:messageFlow id="MF_DHPollDB" name="Poll for Completion Updates" sourceRef="Task_DH_PollTaskDB" targetRef="Event_TDB_ReceivePoll" />
    <bpmn:messageFlow id="MF_DHPollResult" name="Completion Data" sourceRef="Task_TDB_ReturnPollData" targetRef="Event_DH_ReceivePollResult" />
    <bpmn:messageFlow id="MF_DHNotifyDep" name="Task Completed Notification" sourceRef="Task_DH_WriteDepUpdates" targetRef="Start_DG" />
    <bpmn:messageFlow id="MF_ClearWorker" name="Clear Assignment, Set State to &#39;open&#39;" sourceRef="Task_ClearAssignment" targetRef="Event_ClearAssignment" />
    <bpmn:messageFlow id="MF_Confirmation" name="Completion Confirmation" sourceRef="Task_SendConfirmation" targetRef="Event_WorkerConfirm" />
    <bpmn:messageFlow id="MF_Rejection" name="Rejection (state/ID mismatch)" sourceRef="Task_SendRejection" targetRef="Event_WorkerRejection" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Worker" isExecutable="false">
    <bpmn:startEvent id="Start_Worker" name="Worker finishes task">
      <bpmn:outgoing>Flow_W1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_RequestCompletion" name="Request to mark task as complete (submit Task ID)">
      <bpmn:incoming>Flow_W1</bpmn:incoming>
      <bpmn:outgoing>Flow_W2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_WorkerWait" name="">
      <bpmn:incoming>Flow_W2</bpmn:incoming>
      <bpmn:outgoing>Flow_W3a</bpmn:outgoing>
      <bpmn:outgoing>Flow_W3b</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_WorkerConfirm" name="Receive confirmation">
      <bpmn:incoming>Flow_W3a</bpmn:incoming>
      <bpmn:outgoing>Flow_W4a</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WC1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_WorkerRejection" name="Receive rejection">
      <bpmn:incoming>Flow_W3b</bpmn:incoming>
      <bpmn:outgoing>Flow_W4b</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WC2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Worker_Success" name="Task marked complete">
      <bpmn:incoming>Flow_W4a</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Worker_Fail" name="Completion rejected">
      <bpmn:incoming>Flow_W4b</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_W1" sourceRef="Start_Worker" targetRef="Task_RequestCompletion" />
    <bpmn:sequenceFlow id="Flow_W2" sourceRef="Task_RequestCompletion" targetRef="Gateway_WorkerWait" />
    <bpmn:sequenceFlow id="Flow_W3a" sourceRef="Gateway_WorkerWait" targetRef="Event_WorkerConfirm" />
    <bpmn:sequenceFlow id="Flow_W3b" sourceRef="Gateway_WorkerWait" targetRef="Event_WorkerRejection" />
    <bpmn:sequenceFlow id="Flow_W4a" sourceRef="Event_WorkerConfirm" targetRef="End_Worker_Success" />
    <bpmn:sequenceFlow id="Flow_W4b" sourceRef="Event_WorkerRejection" targetRef="End_Worker_Fail" />
  </bpmn:process>
  <bpmn:process id="Process_WorkerAPI" isExecutable="false">
    <bpmn:startEvent id="Start_API" name="Receive completion request">
      <bpmn:outgoing>Flow_A1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_A1" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_VerifyWorker" name="Verify Worker state is &#39;assigned&#39; and Task ID matches current assignment">
      <bpmn:incoming>Flow_A1</bpmn:incoming>
      <bpmn:outgoing>Flow_A2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveVerify" name="Receive verification result">
      <bpmn:incoming>Flow_A2</bpmn:incoming>
      <bpmn:outgoing>Flow_A3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_A2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Verify" name="Verification passed?">
      <bpmn:incoming>Flow_A3</bpmn:incoming>
      <bpmn:outgoing>Flow_VerifyYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_VerifyNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_SendRejection" name="Send rejection to Worker">
      <bpmn:incoming>Flow_VerifyNo</bpmn:incoming>
      <bpmn:outgoing>Flow_EndReject</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_MarkComplete" name="Mark task as &#39;completed&#39; in Task Database">
      <bpmn:incoming>Flow_VerifyYes</bpmn:incoming>
      <bpmn:outgoing>Flow_A4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveMarkAck" name="Receive completion ack">
      <bpmn:incoming>Flow_A4</bpmn:incoming>
      <bpmn:outgoing>Flow_A5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_A3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ClearAssignment" name="Update Worker state to &#39;open&#39; and clear assignment in Worker Database">
      <bpmn:incoming>Flow_A5</bpmn:incoming>
      <bpmn:outgoing>Flow_A7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendConfirmation" name="Send completion confirmation to Worker">
      <bpmn:incoming>Flow_A7</bpmn:incoming>
      <bpmn:outgoing>Flow_EndSuccess</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_APIMerge" name="">
      <bpmn:incoming>Flow_EndSuccess</bpmn:incoming>
      <bpmn:incoming>Flow_EndReject</bpmn:incoming>
      <bpmn:outgoing>Flow_APIEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_API" name="Request handled">
      <bpmn:incoming>Flow_APIEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A1" sourceRef="Start_API" targetRef="Task_VerifyWorker" />
    <bpmn:sequenceFlow id="Flow_A2" sourceRef="Task_VerifyWorker" targetRef="Event_ReceiveVerify" />
    <bpmn:sequenceFlow id="Flow_A3" sourceRef="Event_ReceiveVerify" targetRef="Gateway_Verify" />
    <bpmn:sequenceFlow id="Flow_VerifyYes" name="Yes" sourceRef="Gateway_Verify" targetRef="Task_MarkComplete" />
    <bpmn:sequenceFlow id="Flow_VerifyNo" name="No" sourceRef="Gateway_Verify" targetRef="Task_SendRejection" />
    <bpmn:sequenceFlow id="Flow_A4" sourceRef="Task_MarkComplete" targetRef="Event_ReceiveMarkAck" />
    <bpmn:sequenceFlow id="Flow_A5" sourceRef="Event_ReceiveMarkAck" targetRef="Task_ClearAssignment" />
    <bpmn:sequenceFlow id="Flow_A7" sourceRef="Task_ClearAssignment" targetRef="Task_SendConfirmation" />
    <bpmn:sequenceFlow id="Flow_EndSuccess" sourceRef="Task_SendConfirmation" targetRef="Gateway_APIMerge" />
    <bpmn:sequenceFlow id="Flow_EndReject" sourceRef="Task_SendRejection" targetRef="Gateway_APIMerge" />
    <bpmn:sequenceFlow id="Flow_APIEnd" sourceRef="Gateway_APIMerge" targetRef="End_API" />
  </bpmn:process>
  <bpmn:process id="Process_WorkerDB" isExecutable="false">
    <bpmn:startEvent id="Start_WDB" name="Receive verification request">
      <bpmn:outgoing>Flow_WDB1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckStateAndMatch" name="Check Worker state is &#39;assigned&#39; and Task ID matches">
      <bpmn:incoming>Flow_WDB1</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnVerification" name="Return verification result">
      <bpmn:incoming>Flow_WDB2</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ClearAssignment" name="Receive clear assignment request">
      <bpmn:incoming>Flow_WDB3</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ClearAndSetOpen" name="Clear current assignment; set state to &#39;open&#39;">
      <bpmn:incoming>Flow_WDB4</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_WDB" name="Worker state updated">
      <bpmn:incoming>Flow_WDB5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WDB1" sourceRef="Start_WDB" targetRef="Task_CheckStateAndMatch" />
    <bpmn:sequenceFlow id="Flow_WDB2" sourceRef="Task_CheckStateAndMatch" targetRef="Task_ReturnVerification" />
    <bpmn:sequenceFlow id="Flow_WDB3" sourceRef="Task_ReturnVerification" targetRef="Event_ClearAssignment" />
    <bpmn:sequenceFlow id="Flow_WDB4" sourceRef="Event_ClearAssignment" targetRef="Task_ClearAndSetOpen" />
    <bpmn:sequenceFlow id="Flow_WDB5" sourceRef="Task_ClearAndSetOpen" targetRef="End_WDB" />
  </bpmn:process>
  <bpmn:process id="Process_TaskDB" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_TDB_P3" sourceRef="Task_TDB_ReturnPollData" targetRef="End_TDB_Poll" />
    <bpmn:sequenceFlow id="Flow_TDB_P2" sourceRef="Task_TDB_ExecutePoll" targetRef="Task_TDB_ReturnPollData" />
    <bpmn:sequenceFlow id="Flow_TDB_P1" sourceRef="Event_TDB_ReceivePoll" targetRef="Task_TDB_ExecutePoll" />
    <bpmn:endEvent id="End_TDB_Poll" name="Poll complete">
      <bpmn:incoming>Flow_TDB_P3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_TDB_ReturnPollData" name="Return completion data">
      <bpmn:incoming>Flow_TDB_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB_P3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_TDB_ExecutePoll" name="Query for unprocessed completion data">
      <bpmn:incoming>Flow_TDB_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB_P2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Event_TDB_ReceivePoll" name="Receive poll request">
      <bpmn:outgoing>Flow_TDB_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TDB_Poll" />
    </bpmn:startEvent>
    <bpmn:startEvent id="Start_TDB" name="Receive mark complete request">
      <bpmn:outgoing>Flow_TDB1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TDB1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_SetCompleted" name="Set task status to &#39;completed&#39;">
      <bpmn:incoming>Flow_TDB1</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_AckCompletion" name="Send completion acknowledgment">
      <bpmn:incoming>Flow_TDB2</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_TDB" name="Task marked complete">
      <bpmn:incoming>Flow_TDB3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TDB1" sourceRef="Start_TDB" targetRef="Task_SetCompleted" />
    <bpmn:sequenceFlow id="Flow_TDB2" sourceRef="Task_SetCompleted" targetRef="Task_AckCompletion" />
    <bpmn:sequenceFlow id="Flow_TDB3" sourceRef="Task_AckCompletion" targetRef="End_TDB" />
  </bpmn:process>
  <bpmn:process id="Process_DepGraph" isExecutable="false">
    <bpmn:startEvent id="Start_DG" name="Receive completion notification">
      <bpmn:outgoing>Flow_DG1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DG1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_UpdateDepGraph" name="Mark task as completed in graph; unblock dependent tasks">
      <bpmn:incoming>Flow_DG1</bpmn:incoming>
      <bpmn:outgoing>Flow_DG2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DG" name="Dependencies updated">
      <bpmn:incoming>Flow_DG2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_DG1" sourceRef="Start_DG" targetRef="Task_UpdateDepGraph" />
    <bpmn:sequenceFlow id="Flow_DG2" sourceRef="Task_UpdateDepGraph" targetRef="End_DG" />
  </bpmn:process>
  <bpmn:process id="Process_DepHandler" isExecutable="false">
    <bpmn:startEvent id="Start_DH" name="Polling cycle begins">
      <bpmn:outgoing>Flow_DH1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_DH_PollTaskDB" name="Poll Task Database for unprocessed completion updates">
      <bpmn:incoming>Flow_DH1</bpmn:incoming>
      <bpmn:incoming>Flow_DH_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_DH2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_DH_ReceivePollResult" name="Receive completion data">
      <bpmn:incoming>Flow_DH2</bpmn:incoming>
      <bpmn:outgoing>Flow_DH3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DH1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DH_HasUpdates" name="New completions found?">
      <bpmn:incoming>Flow_DH3</bpmn:incoming>
      <bpmn:outgoing>Flow_DH_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DH_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_DH_WriteDepUpdates" name="Notify Task Dependency Graph of completions">
      <bpmn:incoming>Flow_DH_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_DH4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_DH_Merge" name="">
      <bpmn:incoming>Flow_DH4</bpmn:incoming>
      <bpmn:incoming>Flow_DH_No</bpmn:incoming>
      <bpmn:outgoing>Flow_DH5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_DH_PollWait" name="Wait for next polling interval">
      <bpmn:incoming>Flow_DH5</bpmn:incoming>
      <bpmn:outgoing>Flow_DH_Loop</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_DH" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_DH1" sourceRef="Start_DH" targetRef="Task_DH_PollTaskDB" />
    <bpmn:sequenceFlow id="Flow_DH2" sourceRef="Task_DH_PollTaskDB" targetRef="Event_DH_ReceivePollResult" />
    <bpmn:sequenceFlow id="Flow_DH3" sourceRef="Event_DH_ReceivePollResult" targetRef="Gateway_DH_HasUpdates" />
    <bpmn:sequenceFlow id="Flow_DH_Yes" name="Yes" sourceRef="Gateway_DH_HasUpdates" targetRef="Task_DH_WriteDepUpdates" />
    <bpmn:sequenceFlow id="Flow_DH_No" name="No" sourceRef="Gateway_DH_HasUpdates" targetRef="Gateway_DH_Merge" />
    <bpmn:sequenceFlow id="Flow_DH4" sourceRef="Task_DH_WriteDepUpdates" targetRef="Gateway_DH_Merge" />
    <bpmn:sequenceFlow id="Flow_DH5" sourceRef="Gateway_DH_Merge" targetRef="Event_DH_PollWait" />
    <bpmn:sequenceFlow id="Flow_DH_Loop" sourceRef="Event_DH_PollWait" targetRef="Task_DH_PollTaskDB" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_WF3">
    <bpmndi:BPMNPlane id="BPMNPlane_WF3" bpmnElement="Collaboration_WF3">
      <bpmndi:BPMNShape id="SP_W" bpmnElement="Participant_Worker" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1400" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_SW" bpmnElement="Start_Worker">
        <dc:Bounds x="222" y="132" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_RC" bpmnElement="Task_RequestCompletion">
        <dc:Bounds x="310" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW" bpmnElement="Gateway_WorkerWait">
        <dc:Bounds x="455" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EC" bpmnElement="Event_WorkerConfirm">
        <dc:Bounds x="552" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ER" bpmnElement="Event_WorkerRejection">
        <dc:Bounds x="552" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_ES" bpmnElement="End_Worker_Success">
        <dc:Bounds x="632" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_EF" bpmnElement="End_Worker_Fail">
        <dc:Bounds x="632" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="EW1" bpmnElement="Flow_W1">
        <di:waypoint x="258" y="150" />
        <di:waypoint x="310" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EW2" bpmnElement="Flow_W2">
        <di:waypoint x="410" y="150" />
        <di:waypoint x="455" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EW3a" bpmnElement="Flow_W3a">
        <di:waypoint x="505" y="150" />
        <di:waypoint x="530" y="150" />
        <di:waypoint x="530" y="120" />
        <di:waypoint x="552" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EW3b" bpmnElement="Flow_W3b">
        <di:waypoint x="480" y="175" />
        <di:waypoint x="480" y="190" />
        <di:waypoint x="552" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EW4a" bpmnElement="Flow_W4a">
        <di:waypoint x="588" y="120" />
        <di:waypoint x="632" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="EW4b" bpmnElement="Flow_W4b">
        <di:waypoint x="588" y="190" />
        <di:waypoint x="632" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="SP_A" bpmnElement="Participant_WorkerAPI" isHorizontal="true">
        <dc:Bounds x="160" y="290" width="1400" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA1" bpmnElement="Start_API">
        <dc:Bounds x="222" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA2" bpmnElement="Task_VerifyWorker">
        <dc:Bounds x="300" y="370" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA3" bpmnElement="Event_ReceiveVerify">
        <dc:Bounds x="442" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA4" bpmnElement="Gateway_Verify" isMarkerVisible="true">
        <dc:Bounds x="515" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA5" bpmnElement="Task_SendRejection">
        <dc:Bounds x="600" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA6" bpmnElement="Task_MarkComplete">
        <dc:Bounds x="600" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA7" bpmnElement="Event_ReceiveMarkAck">
        <dc:Bounds x="742" y="462" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA9" bpmnElement="Task_ClearAssignment">
        <dc:Bounds x="960" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA10" bpmnElement="Task_SendConfirmation">
        <dc:Bounds x="1100" y="440" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA11" bpmnElement="Gateway_APIMerge" isMarkerVisible="true">
        <dc:Bounds x="1275" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SA12" bpmnElement="End_API">
        <dc:Bounds x="1372" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
