<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WF4" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_WF4">
    <bpmn:participant id="Participant_Admin" name="Administrator" processRef="Process_Admin" />
    <bpmn:participant id="Participant_AdminAPI" name="Admin API Handler" processRef="Process_AdminAPI" />
    <bpmn:participant id="Participant_TaskDB" name="Task Database" processRef="Process_TaskDB" />
    <bpmn:participant id="Participant_WorkerDB" name="Worker Database" processRef="Process_WorkerDB" />
    <bpmn:participant id="Participant_DepGraph" name="Task Dependency Graph" processRef="Process_DepGraph" />
    <bpmn:participant id="Participant_DepHandler" name="Dependency Handler" processRef="Process_DepHandler" />
    <bpmn:messageFlow id="MF_ViewReq" name="View System Data Request" sourceRef="Task_AdminViewReq" targetRef="Start_AdminAPI" />
    <bpmn:messageFlow id="MF_ReturnData" name="System Data" sourceRef="Task_ReturnSystemData" targetRef="Event_AdminReceiveData" />
    <bpmn:messageFlow id="MF_ReassignReq" name="Reassignment Request" sourceRef="Task_AdminReassign" targetRef="Event_ReceiveReassignReq" />
    <bpmn:messageFlow id="MF_ReassignTask" name="Reassign Task from &#39;completed&#39; to Admin" sourceRef="Task_ReassignInTaskDB" targetRef="Start_TaskDB" />
    <bpmn:messageFlow id="MF_DHPollDB" name="Poll for Reassignment Updates" sourceRef="Task_DH_PollTaskDB" targetRef="Event_TDB_ReceivePoll" />
    <bpmn:messageFlow id="MF_DHPollResult" name="Reassignment Data" sourceRef="Task_TDB_ReturnPollData" targetRef="Event_DH_ReceivePollResult" />
    <bpmn:messageFlow id="MF_DHNotifyDep" name="Task No Longer Complete" sourceRef="Task_DH_WriteDepUpdates" targetRef="Start_DepGraph" />
    <bpmn:messageFlow id="MF_CheckWorkerState" name="Check Worker State" sourceRef="Task_CheckWorkerState" targetRef="Start_WorkerDB" />
    <bpmn:messageFlow id="MF_ReturnWorkerState" name="Worker State" sourceRef="Task_ReturnWorkerState" targetRef="Event_ReceiveWorkerState" />
    <bpmn:messageFlow id="MF_SetInProgress" name="Set State to &#39;in progress&#39;" sourceRef="Task_SetWorkerInProgress" targetRef="Event_SetInProgress" />
    <bpmn:messageFlow id="MF_UnassignCurrent" name="Unassign Current Task" sourceRef="Task_UnassignCurrentTask" targetRef="Event_UnassignTask" />
    <bpmn:messageFlow id="MF_AssignDesired" name="Assign Desired Task to Worker" sourceRef="Task_AssignDesiredTask" targetRef="Event_AssignDesired" />
    <bpmn:messageFlow id="MF_UpdateWorkerAssignment" name="Update Worker Assignment and Set &#39;assigned&#39;" sourceRef="Task_UpdateWorkerAssignment" targetRef="Event_UpdateWorkerAssignment" />
    <bpmn:messageFlow id="MF_Confirmation" name="Reassignment Confirmation" sourceRef="Task_SendAdminConfirm" targetRef="Event_AdminConfirm" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Admin" isExecutable="false">
    <bpmn:startEvent id="Start_Admin" name="Administrator needs to modify data">
      <bpmn:outgoing>Flow_AD1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_AdminViewReq" name="Request to view system data">
      <bpmn:incoming>Flow_AD1</bpmn:incoming>
      <bpmn:outgoing>Flow_AD2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_AdminReceiveData" name="Receive system data">
      <bpmn:incoming>Flow_AD2</bpmn:incoming>
      <bpmn:outgoing>Flow_AD3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AD1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_AdminReview" name="Review data and decide to reassign a completed task to a Worker">
      <bpmn:incoming>Flow_AD3</bpmn:incoming>
      <bpmn:outgoing>Flow_AD4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_AdminReassign" name="Submit reassignment request (task ID, target Worker ID)">
      <bpmn:incoming>Flow_AD4</bpmn:incoming>
      <bpmn:outgoing>Flow_AD5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_AdminConfirm" name="Receive confirmation">
      <bpmn:incoming>Flow_AD5</bpmn:incoming>
      <bpmn:outgoing>Flow_AD6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AD2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Admin" name="Reassignment complete">
      <bpmn:incoming>Flow_AD6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_AD1" sourceRef="Start_Admin" targetRef="Task_AdminViewReq" />
    <bpmn:sequenceFlow id="Flow_AD2" sourceRef="Task_AdminViewReq" targetRef="Event_AdminReceiveData" />
    <bpmn:sequenceFlow id="Flow_AD3" sourceRef="Event_AdminReceiveData" targetRef="Task_AdminReview" />
    <bpmn:sequenceFlow id="Flow_AD4" sourceRef="Task_AdminReview" targetRef="Task_AdminReassign" />
    <bpmn:sequenceFlow id="Flow_AD5" sourceRef="Task_AdminReassign" targetRef="Event_AdminConfirm" />
    <bpmn:sequenceFlow id="Flow_AD6" sourceRef="Event_AdminConfirm" targetRef="End_Admin" />
  </bpmn:process>
  <bpmn:process id="Process_AdminAPI" isExecutable="false">
    <bpmn:startEvent id="Start_AdminAPI" name="Receive view data request">
      <bpmn:outgoing>Flow_API1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchSystemData" name="Fetch data from Task Database, Worker Database, and Task Dependency Graph">
      <bpmn:incoming>Flow_API1</bpmn:incoming>
      <bpmn:outgoing>Flow_API2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnSystemData" name="Return system data to Administrator">
      <bpmn:incoming>Flow_API2</bpmn:incoming>
      <bpmn:outgoing>Flow_API3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveReassignReq" name="Receive reassignment request">
      <bpmn:incoming>Flow_API3</bpmn:incoming>
      <bpmn:outgoing>Flow_API4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ReassignInTaskDB" name="Step 3: Reassign task from &#39;completed&#39; to Admin in Task Database">
      <bpmn:incoming>Flow_API4</bpmn:incoming>
      <bpmn:outgoing>Flow_API5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_API1" sourceRef="Start_AdminAPI" targetRef="Task_FetchSystemData" />
    <bpmn:sequenceFlow id="Flow_API2" sourceRef="Task_FetchSystemData" targetRef="Task_ReturnSystemData" />
    <bpmn:sequenceFlow id="Flow_API3" sourceRef="Task_ReturnSystemData" targetRef="Event_ReceiveReassignReq" />
    <bpmn:sequenceFlow id="Flow_API4" sourceRef="Event_ReceiveReassignReq" targetRef="Task_ReassignInTaskDB" />
    <bpmn:sequenceFlow id="Flow_API5" sourceRef="Task_ReassignInTaskDB" targetRef="Task_CheckWorkerState" />
    <bpmn:sendTask id="Task_CheckWorkerState" name="Step 5: Check target Worker&#39;s state in Worker Database">
      <bpmn:incoming>Flow_API5</bpmn:incoming>
      <bpmn:outgoing>Flow_API7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveWorkerState" name="Receive Worker state">
      <bpmn:incoming>Flow_API7</bpmn:incoming>
      <bpmn:outgoing>Flow_API8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_WorkerState" name="Worker&#39;s state?">
      <bpmn:incoming>Flow_API8</bpmn:incoming>
      <bpmn:outgoing>Flow_StateOpen</bpmn:outgoing>
      <bpmn:outgoing>Flow_StateAssigned</bpmn:outgoing>
      <bpmn:outgoing>Flow_StateInProgress</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_WaitStateChange" name="Wait until state changes">
      <bpmn:incoming>Flow_StateInProgress</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_SetWorkerInProgress" name="Set Worker state to &#39;in progress&#39;">
      <bpmn:incoming>Flow_StateOpen</bpmn:incoming>
      <bpmn:incoming>Flow_AfterRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_API9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_RecordCurrentTask" name="Record Worker&#39;s currently assigned task (for later unassignment)">
      <bpmn:incoming>Flow_StateAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterRecord</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_HasCurrentTask" name="Worker had a current task?">
      <bpmn:incoming>Flow_API9</bpmn:incoming>
      <bpmn:outgoing>Flow_YesCurrent</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoCurrent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_UnassignCurrentTask" name="Step 6a: Unassign Worker&#39;s current task in Task Database (set to &#39;unassigned&#39;)">
      <bpmn:incoming>Flow_YesCurrent</bpmn:incoming>
      <bpmn:outgoing>Flow_AfterUnassign</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_MergeUnassign" name="">
      <bpmn:incoming>Flow_AfterUnassign</bpmn:incoming>
      <bpmn:incoming>Flow_NoCurrent</bpmn:incoming>
      <bpmn:outgoing>Flow_API10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_AssignDesiredTask" name="Step 6b: Assign desired task to Worker in Task Database">
      <bpmn:incoming>Flow_API10</bpmn:incoming>
      <bpmn:outgoing>Flow_API11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_UpdateWorkerAssignment" name="Step 7: Update Worker&#39;s assignment in Worker Database; set state to &#39;assigned&#39;">
      <bpmn:incoming>Flow_API11</bpmn:incoming>
      <bpmn:outgoing>Flow_API12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SendAdminConfirm" name="Send confirmation to Administrator">
      <bpmn:incoming>Flow_API12</bpmn:incoming>
      <bpmn:outgoing>Flow_APIEnd</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_AdminAPI" name="Reassignment handled">
      <bpmn:incoming>Flow_APIEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RetryCheck" sourceRef="Event_WaitStateChange" targetRef="Task_CheckWorkerState" />
    <bpmn:sequenceFlow id="Flow_API7" sourceRef="Task_CheckWorkerState" targetRef="Event_ReceiveWorkerState" />
    <bpmn:sequenceFlow id="Flow_API8" sourceRef="Event_ReceiveWorkerState" targetRef="Gateway_WorkerState" />
    <bpmn:sequenceFlow id="Flow_StateOpen" name="open" sourceRef="Gateway_WorkerState" targetRef="Task_SetWorkerInProgress" />
    <bpmn:sequenceFlow id="Flow_StateAssigned" name="assigned" sourceRef="Gateway_WorkerState" targetRef="Task_RecordCurrentTask" />
    <bpmn:sequenceFlow id="Flow_StateInProgress" name="in progress" sourceRef="Gateway_WorkerState" targetRef="Event_WaitStateChange" />
    <bpmn:sequenceFlow id="Flow_AfterRecord" sourceRef="Task_RecordCurrentTask" targetRef="Task_SetWorkerInProgress" />
    <bpmn:sequenceFlow id="Flow_API9" sourceRef="Task_SetWorkerInProgress" targetRef="Gateway_HasCurrentTask" />
    <bpmn:sequenceFlow id="Flow_YesCurrent" name="Yes" sourceRef="Gateway_HasCurrentTask" targetRef="Task_UnassignCurrentTask" />
    <bpmn:sequenceFlow id="Flow_NoCurrent" name="No" sourceRef="Gateway_HasCurrentTask" targetRef="Gateway_MergeUnassign" />
    <bpmn:sequenceFlow id="Flow_AfterUnassign" sourceRef="Task_UnassignCurrentTask" targetRef="Gateway_MergeUnassign" />
    <bpmn:sequenceFlow id="Flow_API10" sourceRef="Gateway_MergeUnassign" targetRef="Task_AssignDesiredTask" />
    <bpmn:sequenceFlow id="Flow_API11" sourceRef="Task_AssignDesiredTask" targetRef="Task_UpdateWorkerAssignment" />
    <bpmn:sequenceFlow id="Flow_API12" sourceRef="Task_UpdateWorkerAssignment" targetRef="Task_SendAdminConfirm" />
    <bpmn:sequenceFlow id="Flow_APIEnd" sourceRef="Task_SendAdminConfirm" targetRef="End_AdminAPI" />
  </bpmn:process>
  <bpmn:process id="Process_TaskDB" isExecutable="false">
    <bpmn:startEvent id="Start_TaskDB" name="Receive reassign request">
      <bpmn:outgoing>Flow_TDB1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TDB1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ReassignFromCompleted" name="Change task status from &#39;completed&#39; to assigned to Admin">
      <bpmn:incoming>Flow_TDB1</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_UnassignTask" name="Receive unassign current task request">
      <bpmn:incoming>Flow_TDB2</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TDB2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_UnassignInDB" name="Set Worker&#39;s current task to &#39;unassigned&#39;">
      <bpmn:incoming>Flow_TDB3</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_AssignDesired" name="Receive assign desired task request">
      <bpmn:incoming>Flow_TDB4</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TDB3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_AssignDesiredInDB" name="Assign desired task to target Worker">
      <bpmn:incoming>Flow_TDB5</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_TaskDB" name="Task reassignment recorded">
      <bpmn:incoming>Flow_TDB6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TDB1" sourceRef="Start_TaskDB" targetRef="Task_ReassignFromCompleted" />
    <bpmn:sequenceFlow id="Flow_TDB2" sourceRef="Task_ReassignFromCompleted" targetRef="Event_UnassignTask" />
    <bpmn:sequenceFlow id="Flow_TDB3" sourceRef="Event_UnassignTask" targetRef="Task_UnassignInDB" />
    <bpmn:sequenceFlow id="Flow_TDB4" sourceRef="Task_UnassignInDB" targetRef="Event_AssignDesired" />
    <bpmn:sequenceFlow id="Flow_TDB5" sourceRef="Event_AssignDesired" targetRef="Task_AssignDesiredInDB" />
    <bpmn:sequenceFlow id="Flow_TDB6" sourceRef="Task_AssignDesiredInDB" targetRef="End_TaskDB" />
    <bpmn:startEvent id="Event_TDB_ReceivePoll" name="Receive poll request">
      <bpmn:outgoing>Flow_TDB_P1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TDB_Poll" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_TDB_ExecutePoll" name="Query for unprocessed reassignment data">
      <bpmn:incoming>Flow_TDB_P1</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB_P2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_TDB_ReturnPollData" name="Return reassignment data">
      <bpmn:incoming>Flow_TDB_P2</bpmn:incoming>
      <bpmn:outgoing>Flow_TDB_P3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_TDB_Poll" name="Poll complete">
      <bpmn:incoming>Flow_TDB_P3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TDB_P1" sourceRef="Event_TDB_ReceivePoll" targetRef="Task_TDB_ExecutePoll" />
    <bpmn:sequenceFlow id="Flow_TDB_P2" sourceRef="Task_TDB_ExecutePoll" targetRef="Task_TDB_ReturnPollData" />
    <bpmn:sequenceFlow id="Flow_TDB_P3" sourceRef="Task_TDB_ReturnPollData" targetRef="End_TDB_Poll" />
  </bpmn:process>
  <bpmn:process id="Process_WorkerDB" isExecutable="false">
    <bpmn:startEvent id="Start_WorkerDB" name="Receive state check">
      <bpmn:outgoing>Flow_WDB1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_LookupWorkerState" name="Look up Worker&#39;s current state and assignment">
      <bpmn:incoming>Flow_WDB1</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnWorkerState" name="Return Worker state">
      <bpmn:incoming>Flow_WDB2</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_SetInProgress" name="Receive set &#39;in progress&#39; request">
      <bpmn:incoming>Flow_WDB3</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_SetStateInProgress" name="Set Worker state to &#39;in progress&#39;">
      <bpmn:incoming>Flow_WDB4</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_UpdateWorkerAssignment" name="Receive update assignment request">
      <bpmn:incoming>Flow_WDB5</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_UpdateAssignment" name="Update Worker&#39;s assignment to desired task; set state to &#39;assigned&#39;">
      <bpmn:incoming>Flow_WDB6</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_WorkerDB" name="Worker reassigned">
      <bpmn:incoming>Flow_WDB7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WDB1" sourceRef="Start_WorkerDB" targetRef="Task_LookupWorkerState" />
    <bpmn:sequenceFlow id="Flow_WDB2" sourceRef="Task_LookupWorkerState" targetRef="Task_ReturnWorkerState" />
    <bpmn:sequenceFlow id="Flow_WDB3" sourceRef="Task_ReturnWorkerState" targetRef="Event_SetInProgress" />
    <bpmn:sequenceFlow id="Flow_WDB4" sourceRef="Event_SetInProgress" targetRef="Task_SetStateInProgress" />
    <bpmn:sequenceFlow id="Flow_WDB5" sourceRef="Task_SetStateInProgress" targetRef="Event_UpdateWorkerAssignment" />
    <bpmn:sequenceFlow id="Flow_WDB6" sourceRef="Event_UpdateWorkerAssignment" targetRef="Task_UpdateAssignment" />
    <bpmn:sequenceFlow id="Flow_WDB7" sourceRef="Task_UpdateAssignment" targetRef="End_WorkerDB" />
  </bpmn:process>
  <bpmn:process id="Process_DepGraph" isExecutable="false">
    <bpmn:startEvent id="Start_DepGraph" name="Receive task no longer complete notification">
      <bpmn:outgoing>Flow_DG1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DG1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RevertCompletion" name="Mark task as incomplete; re-block dependent tasks">
      <bpmn:incoming>Flow_DG1</bpmn:incoming>
      <bpmn:outgoing>Flow_DG2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_DepGraph" name="Graph updated">
      <bpmn:incoming>Flow_DG2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_DG1" sourceRef="Start_DepGraph" targetRef="Task_RevertCompletion" />
    <bpmn:sequenceFlow id="Flow_DG2" sourceRef="Task_RevertCompletion" targetRef="End_DepGraph" />
  </bpmn:process>
  <bpmn:process id="Process_DepHandler" isExecutable="false">
    <bpmn:startEvent id="Start_DH" name="Polling cycle begins">
      <bpmn:outgoing>Flow_DH1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_DH_PollTaskDB" name="Poll Task Database for unprocessed reassignment updates">
      <bpmn:incoming>Flow_DH1</bpmn:incoming>
      <bpmn:incoming>Flow_DH_Loop</bpmn:incoming>
      <bpmn:outgoing>Flow_DH2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_DH_ReceivePollResult" name="Receive reassignment data">
      <bpmn:incoming>Flow_DH2</bpmn:incoming>
      <bpmn:outgoing>Flow_DH3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_DH1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_DH_HasUpdates" name="New reassignments found?">
      <bpmn:incoming>Flow_DH3</bpmn:incoming>
      <bpmn:outgoing>Flow_DH_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_DH_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_DH_WriteDepUpdates" name="Notify Task Dependency Graph of reassignments">
      <bpmn:incoming>Flow_DH_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_DH4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_DH_Merge" name="">
      <bpmn:incoming>Flow_DH4</bpmn:incoming>
      <bpmn:incoming>Flow_DH_No</bpmn:incoming>
      <bpmn:outgoing>Flow_DH5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_DH_PollWait" name="Wait for next polling interval">
      <bpmn:incoming>Flow_DH5</bpmn:incoming>
      <bpmn:outgoing>Flow_DH_Loop</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_DH" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_DH1" sourceRef="Start_DH" targetRef="Task_DH_PollTaskDB" />
    <bpmn:sequenceFlow id="Flow_DH2" sourceRef="Task_DH_PollTaskDB" targetRef="Event_DH_ReceivePollResult" />
    <bpmn:sequenceFlow id="Flow_DH3" sourceRef="Event_DH_ReceivePollResult" targetRef="Gateway_DH_HasUpdates" />
    <bpmn:sequenceFlow id="Flow_DH_Yes" name="Yes" sourceRef="Gateway_DH_HasUpdates" targetRef="Task_DH_WriteDepUpdates" />
    <bpmn:sequenceFlow id="Flow_DH_No" name="No" sourceRef="Gateway_DH_HasUpdates" targetRef="Gateway_DH_Merge" />
