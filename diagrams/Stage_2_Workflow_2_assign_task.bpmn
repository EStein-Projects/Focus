<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WF2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_WF2">
    <bpmn:participant id="Participant_Worker" name="Worker" processRef="Process_Worker" />
    <bpmn:participant id="Participant_WorkerAPI" name="Worker API Handler" processRef="Process_WorkerAPI" />
    <bpmn:participant id="Participant_WorkerDB" name="Worker Database" processRef="Process_WorkerDB" />
    <bpmn:participant id="Participant_TaskAssign" name="Task Assignment Engine" processRef="Process_TaskAssign" />
    <bpmn:participant id="Participant_DepGraph" name="Task Dependency Graph" processRef="Process_DepGraph" />
    <bpmn:participant id="Participant_TaskDB" name="Task Database" processRef="Process_TaskDB" />
    <bpmn:messageFlow id="MF_WorkerReq" name="New Task Request" sourceRef="Task_WorkerRequest" targetRef="Start_WorkerAPI" />
    <bpmn:messageFlow id="MF_DeliverTask" name="Task Details" sourceRef="Task_DeliverTask" targetRef="Event_WorkerReceivesTask" />
    <bpmn:messageFlow id="MF_ReturnAssignedExisting" name="Currently Assigned Task" sourceRef="Task_ReturnAssigned" targetRef="Event_WorkerReceivesTask" />
    <bpmn:messageFlow id="MF_CheckState" name="Check Worker State" sourceRef="Task_CheckWorkerState" targetRef="Start_WorkerDB" />
    <bpmn:messageFlow id="MF_ReturnState" name="Worker State" sourceRef="Task_ReturnWorkerState" targetRef="Event_ReceiveState" />
    <bpmn:messageFlow id="MF_SetInProgress" name="Conditional Write: Set State to &#39;in progress&#39; WHERE state = &#39;open&#39;" sourceRef="Task_SetInProgress" targetRef="Event_SetStateReq" />
    <bpmn:messageFlow id="MF_SetInProgressAck" name="State Change Result (success/failure)" sourceRef="Task_ReturnSetResult" targetRef="Event_ReceiveSetResult" />
    <bpmn:messageFlow id="MF_CallEngine" name="Assign Task Request" sourceRef="Task_CallEngine" targetRef="Start_TaskAssign" />
    <bpmn:messageFlow id="MF_QueryUnblocked" name="Query Unblocked Tasks" sourceRef="Task_QueryUnblocked" targetRef="Start_DepGraph" />
    <bpmn:messageFlow id="MF_ReturnUnblocked" name="Unblocked Task List" sourceRef="Task_ReturnUnblocked" targetRef="Event_ReceiveUnblocked" />
    <bpmn:messageFlow id="MF_ReadWorkerMeta" name="Read Worker Metadata" sourceRef="Task_ReadWorkerMeta" targetRef="Event_ReadWorkerMetaReq" />
    <bpmn:messageFlow id="MF_ReturnWorkerMeta" name="Worker Metadata" sourceRef="Task_ReturnWorkerMeta" targetRef="Event_ReceiveWorkerMeta" />
    <bpmn:messageFlow id="MF_AttemptAssign" name="Attempt to Assign Task" sourceRef="Task_AttemptAssign" targetRef="Start_TaskDB" />
    <bpmn:messageFlow id="MF_AssignResult" name="Assignment Result" sourceRef="Task_ReturnAssignResult" targetRef="Event_ReceiveAssignResult" />
    <bpmn:messageFlow id="MF_RecordAssignment" name="Conditional Write: Record Assignment WHERE state = &#39;in progress&#39;" sourceRef="Task_RecordAssignment" targetRef="Event_RecordAssignmentReq" />
    <bpmn:messageFlow id="MF_RecordAssignmentResult" name="Record Result (success/failure)" sourceRef="Task_ReturnRecordResult" targetRef="Event_ReceiveRecordResult" />
    <bpmn:messageFlow id="MF_ReturnTask" name="Assigned Task" sourceRef="Task_ReturnNewTask" targetRef="Event_ReceiveNewTask" />
    <bpmn:messageFlow id="Flow_01zioow" sourceRef="Activity_1thh7ty" targetRef="Event_0skpvw5" />
    <bpmn:messageFlow id="Flow_1clduui" sourceRef="Activity_1i817aj" targetRef="Event_0bm8tmy" />
    <bpmn:textAnnotation id="TextAnnotation_1ceerfx">
      <bpmn:text>Precheck Query</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0y3jtlt" associationDirection="None" sourceRef="Flow_01zioow" targetRef="TextAnnotation_1ceerfx" />
    <bpmn:textAnnotation id="TextAnnotation_0wbr8zo">
      <bpmn:text>Query Result</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0e0yk47" associationDirection="None" sourceRef="Flow_1clduui" targetRef="TextAnnotation_0wbr8zo" />
    <bpmn:textAnnotation id="TextAnnotation_1fm1mph">
      <bpmn:text>No</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1pdspjk" associationDirection="None" sourceRef="Flow_1r88912" targetRef="TextAnnotation_1fm1mph" />
    <bpmn:textAnnotation id="TextAnnotation_1v46e61">
      <bpmn:text>Yes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1z08jxw" associationDirection="None" sourceRef="Flow_0xpen27" targetRef="TextAnnotation_1v46e61" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Worker" isExecutable="false">
    <bpmn:startEvent id="Start_Worker" name="Worker ready for new task">
      <bpmn:outgoing>Flow_W1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_WorkerRequest" name="Request new task from system">
      <bpmn:incoming>Flow_W1</bpmn:incoming>
      <bpmn:outgoing>Flow_W2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_WorkerReceivesTask" name="Receive assigned task">
      <bpmn:incoming>Flow_W2</bpmn:incoming>
      <bpmn:outgoing>Flow_W3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_W1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Worker" name="Worker begins task">
      <bpmn:incoming>Flow_W3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_W1" sourceRef="Start_Worker" targetRef="Task_WorkerRequest" />
    <bpmn:sequenceFlow id="Flow_W2" sourceRef="Task_WorkerRequest" targetRef="Event_WorkerReceivesTask" />
    <bpmn:sequenceFlow id="Flow_W3" sourceRef="Event_WorkerReceivesTask" targetRef="End_Worker" />
  </bpmn:process>
  <bpmn:process id="Process_WorkerAPI" isExecutable="false">
    <bpmn:startEvent id="Start_WorkerAPI" name="Receive new task request">
      <bpmn:outgoing>Flow_API1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API1" />
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_CheckWorkerState" name="Check Worker&#39;s state in Worker Database">
      <bpmn:incoming>Flow_API1</bpmn:incoming>
      <bpmn:incoming>Flow_RetryCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_API2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveState" name="Receive Worker state">
      <bpmn:incoming>Flow_API2</bpmn:incoming>
      <bpmn:outgoing>Flow_API3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_WorkerState" name="Worker&#39;s state?">
      <bpmn:incoming>Flow_API3</bpmn:incoming>
      <bpmn:outgoing>Flow_StateOpen</bpmn:outgoing>
      <bpmn:outgoing>Flow_StateAssigned</bpmn:outgoing>
      <bpmn:outgoing>Flow_StateInProgress</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_WaitStateChange" name="Wait until state changes">
      <bpmn:incoming>Flow_StateInProgress</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryCheck</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ReturnAssigned" name="Return currently assigned task to Worker">
      <bpmn:incoming>Flow_StateAssigned</bpmn:incoming>
      <bpmn:outgoing>Flow_APIEnd_Assigned</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_SetInProgress" name="Conditional write: set Worker state to &#39;in progress&#39; WHERE state = &#39;open&#39;">
      <bpmn:incoming>Flow_StateOpen</bpmn:incoming>
      <bpmn:outgoing>Flow_API_WaitSetResult</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveSetResult" name="Receive state change result">
      <bpmn:incoming>Flow_API_WaitSetResult</bpmn:incoming>
      <bpmn:outgoing>Flow_API_CheckSetResult</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API_SetResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_SetResultCheck" name="State change succeeded?">
      <bpmn:incoming>Flow_API_CheckSetResult</bpmn:incoming>
      <bpmn:outgoing>Flow_SetSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_SetFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_CallEngine" name="Call Task Assignment Engine to assign new task">
      <bpmn:incoming>Flow_SetSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_API5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveNewTask" name="Receive newly assigned task">
      <bpmn:incoming>Flow_API5</bpmn:incoming>
      <bpmn:outgoing>Flow_API6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_API3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_DeliverTask" name="Return new task to Worker">
      <bpmn:incoming>Flow_API6</bpmn:incoming>
      <bpmn:outgoing>Flow_APIEnd_New</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="Gateway_APIMerge" name="">
      <bpmn:incoming>Flow_APIEnd_Assigned</bpmn:incoming>
      <bpmn:incoming>Flow_APIEnd_New</bpmn:incoming>
      <bpmn:outgoing>Flow_APIEnd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_WorkerAPI" name="Task delivered to Worker">
      <bpmn:incoming>Flow_APIEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_API1" sourceRef="Start_WorkerAPI" targetRef="Task_CheckWorkerState" />
    <bpmn:sequenceFlow id="Flow_API2" sourceRef="Task_CheckWorkerState" targetRef="Event_ReceiveState" />
    <bpmn:sequenceFlow id="Flow_API3" sourceRef="Event_ReceiveState" targetRef="Gateway_WorkerState" />
    <bpmn:sequenceFlow id="Flow_StateOpen" name="open" sourceRef="Gateway_WorkerState" targetRef="Task_SetInProgress" />
    <bpmn:sequenceFlow id="Flow_StateAssigned" name="assigned" sourceRef="Gateway_WorkerState" targetRef="Task_ReturnAssigned" />
    <bpmn:sequenceFlow id="Flow_StateInProgress" name="in progress" sourceRef="Gateway_WorkerState" targetRef="Event_WaitStateChange" />
    <bpmn:sequenceFlow id="Flow_RetryCheck" sourceRef="Event_WaitStateChange" targetRef="Task_CheckWorkerState" />
    <bpmn:sequenceFlow id="Flow_API_WaitSetResult" sourceRef="Task_SetInProgress" targetRef="Event_ReceiveSetResult" />
    <bpmn:sequenceFlow id="Flow_API_CheckSetResult" sourceRef="Event_ReceiveSetResult" targetRef="Gateway_SetResultCheck" />
    <bpmn:sequenceFlow id="Flow_SetSuccess" name="Yes (ownership acquired)" sourceRef="Gateway_SetResultCheck" targetRef="Task_CallEngine" />
    <bpmn:sequenceFlow id="Flow_SetFail" name="No (state changed by another instance)" sourceRef="Gateway_SetResultCheck" targetRef="Task_CheckWorkerState" />
    <bpmn:sequenceFlow id="Flow_API5" sourceRef="Task_CallEngine" targetRef="Event_ReceiveNewTask" />
    <bpmn:sequenceFlow id="Flow_API6" sourceRef="Event_ReceiveNewTask" targetRef="Task_DeliverTask" />
    <bpmn:sequenceFlow id="Flow_APIEnd_Assigned" sourceRef="Task_ReturnAssigned" targetRef="Gateway_APIMerge" />
    <bpmn:sequenceFlow id="Flow_APIEnd_New" sourceRef="Task_DeliverTask" targetRef="Gateway_APIMerge" />
    <bpmn:sequenceFlow id="Flow_APIEnd" sourceRef="Gateway_APIMerge" targetRef="End_WorkerAPI" />
  </bpmn:process>
  <bpmn:process id="Process_WorkerDB" isExecutable="false">
    <bpmn:startEvent id="Start_WorkerDB" name="Receive state check request">
      <bpmn:outgoing>Flow_WDB1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_LookupState" name="Look up Worker&#39;s current state">
      <bpmn:incoming>Flow_WDB1</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnWorkerState" name="Return Worker state">
      <bpmn:incoming>Flow_WDB2</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB_End1</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_WDB_StateCheck" name="State check complete">
      <bpmn:incoming>Flow_WDB_End1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_SetStateReq" name="Receive conditional write request">
      <bpmn:outgoing>Flow_WDB3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB2" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ConditionalWrite" name="Execute: UPDATE state = &#39;in progress&#39; WHERE state = &#39;open&#39;">
      <bpmn:incoming>Flow_WDB3</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnSetResult" name="Return result (success if state was &#39;open&#39;, failure otherwise)">
      <bpmn:incoming>Flow_WDB4</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB_End2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_WDB_SetState" name="Conditional write complete">
      <bpmn:incoming>Flow_WDB_End2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_ReadWorkerMetaReq" name="Receive metadata read request">
      <bpmn:outgoing>Flow_WDB5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB3" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_LookupWorkerMeta" name="Look up Worker&#39;s metadata (skills, capacity, history)">
      <bpmn:incoming>Flow_WDB5</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnWorkerMeta" name="Return Worker metadata">
      <bpmn:incoming>Flow_WDB6</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB_End3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_WDB_Meta" name="Metadata read complete">
      <bpmn:incoming>Flow_WDB_End3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_RecordAssignmentReq" name="Receive record assignment request">
      <bpmn:outgoing>Flow_WDB7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_WDB4" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_GuardedAssignWrite" name="Execute: UPDATE assignment, state = &#39;assigned&#39; WHERE state = &#39;in progress&#39;">
      <bpmn:incoming>Flow_WDB7</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_ReturnRecordResult" name="Return result (success if state was &#39;in progress&#39;, failure and current task otherwise)">
      <bpmn:incoming>Flow_WDB8</bpmn:incoming>
      <bpmn:outgoing>Flow_WDB_End4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_WDB_Record" name="Record assignment complete">
      <bpmn:incoming>Flow_WDB_End4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_WDB1" sourceRef="Start_WorkerDB" targetRef="Task_LookupState" />
    <bpmn:sequenceFlow id="Flow_WDB2" sourceRef="Task_LookupState" targetRef="Task_ReturnWorkerState" />
    <bpmn:sequenceFlow id="Flow_WDB_End1" sourceRef="Task_ReturnWorkerState" targetRef="End_WDB_StateCheck" />
    <bpmn:sequenceFlow id="Flow_WDB3" sourceRef="Event_SetStateReq" targetRef="Task_ConditionalWrite" />
    <bpmn:sequenceFlow id="Flow_WDB4" sourceRef="Task_ConditionalWrite" targetRef="Task_ReturnSetResult" />
    <bpmn:sequenceFlow id="Flow_WDB_End2" sourceRef="Task_ReturnSetResult" targetRef="End_WDB_SetState" />
    <bpmn:sequenceFlow id="Flow_WDB5" sourceRef="Event_ReadWorkerMetaReq" targetRef="Task_LookupWorkerMeta" />
    <bpmn:sequenceFlow id="Flow_WDB6" sourceRef="Task_LookupWorkerMeta" targetRef="Task_ReturnWorkerMeta" />
    <bpmn:sequenceFlow id="Flow_WDB_End3" sourceRef="Task_ReturnWorkerMeta" targetRef="End_WDB_Meta" />
    <bpmn:sequenceFlow id="Flow_WDB7" sourceRef="Event_RecordAssignmentReq" targetRef="Task_GuardedAssignWrite" />
    <bpmn:sequenceFlow id="Flow_WDB8" sourceRef="Task_GuardedAssignWrite" targetRef="Task_ReturnRecordResult" />
    <bpmn:sequenceFlow id="Flow_WDB_End4" sourceRef="Task_ReturnRecordResult" targetRef="End_WDB_Record" />
  </bpmn:process>
  <bpmn:process id="Process_TaskAssign" isExecutable="false">
    <bpmn:sequenceFlow id="Flow_TA6" sourceRef="Task_FilterAndSort" targetRef="Activity_1thh7ty" />
    <bpmn:sequenceFlow id="Flow_TA5" sourceRef="Event_ReceiveWorkerMeta" targetRef="Task_FilterAndSort" />
    <bpmn:sequenceFlow id="Flow_TA4" sourceRef="Task_ReadWorkerMeta" targetRef="Event_ReceiveWorkerMeta" />
    <bpmn:sequenceFlow id="Flow_TA3" sourceRef="Event_ReceiveUnblocked" targetRef="Task_ReadWorkerMeta" />
    <bpmn:sequenceFlow id="Flow_TA2" sourceRef="Task_QueryUnblocked" targetRef="Event_ReceiveUnblocked" />
    <bpmn:sequenceFlow id="Flow_TA1" sourceRef="Start_TaskAssign" targetRef="Task_QueryUnblocked" />
    <bpmn:startEvent id="Start_TaskAssign" name="Receive assignment request">
      <bpmn:outgoing>Flow_TA1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TA1" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_10lcpbq" sourceRef="Activity_1thh7ty" targetRef="Event_0bm8tmy" />
    <bpmn:sequenceFlow id="Flow_RecordNo" name="No (state conflict - edge case)" sourceRef="Gateway_RecordSuccess" targetRef="Task_RevertTaskAssign" />
    <bpmn:sequenceFlow id="Flow_TA_Abort" sourceRef="Task_RevertTaskAssign" targetRef="Task_ReturnNewTask" />
    <bpmn:serviceTask id="Task_MoveToNext" name="Move to next candidate task in sorted list">
      <bpmn:incoming>Flow_AssignNo</bpmn:incoming>
      <bpmn:outgoing>Flow_RetryAssign</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveRecordResult" name="Receive record result">
      <bpmn:incoming>Flow_TA_WaitRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_TA_CheckRecord</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TA_Record" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_RecordSuccess" name="Worker not in &#39;assigned&#39; state?">
      <bpmn:incoming>Flow_TA_CheckRecord</bpmn:incoming>
      <bpmn:outgoing>Flow_RecordYes</bpmn:outgoing>
      <bpmn:outgoing>Flow_RecordNo</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_ReturnNewTask" name="Return assigned task to Worker API Handler">
      <bpmn:incoming>Flow_RecordYes</bpmn:incoming>
      <bpmn:incoming>Flow_TA_Abort</bpmn:incoming>
      <bpmn:outgoing>Flow_TA10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_TaskAssign" name="Task assigned successfully">
      <bpmn:incoming>Flow_TA10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RetryAssign" sourceRef="Task_MoveToNext" targetRef="Task_AttemptAssign" />
    <bpmn:sequenceFlow id="Flow_TA7" sourceRef="Task_AttemptAssign" targetRef="Event_ReceiveAssignResult" />
    <bpmn:sequenceFlow id="Flow_TA8" sourceRef="Event_ReceiveAssignResult" targetRef="Gateway_AssignSuccess" />
    <bpmn:sequenceFlow id="Flow_AssignYes" name="Yes" sourceRef="Gateway_AssignSuccess" targetRef="Task_RecordAssignment" />
    <bpmn:sequenceFlow id="Flow_AssignNo" name="No (task already taken)" sourceRef="Gateway_AssignSuccess" targetRef="Task_MoveToNext" />
    <bpmn:sequenceFlow id="Flow_TA_WaitRecord" sourceRef="Task_RecordAssignment" targetRef="Event_ReceiveRecordResult" />
    <bpmn:sequenceFlow id="Flow_TA_CheckRecord" sourceRef="Event_ReceiveRecordResult" targetRef="Gateway_RecordSuccess" />
    <bpmn:sequenceFlow id="Flow_RecordYes" name="Yes (state was &#39;in progress&#39;)" sourceRef="Gateway_RecordSuccess" targetRef="Task_ReturnNewTask" />
    <bpmn:sequenceFlow id="Flow_TA10" sourceRef="Task_ReturnNewTask" targetRef="End_TaskAssign" />
    <bpmn:sequenceFlow id="Flow_0cxch34" sourceRef="Event_0bm8tmy" targetRef="Gateway_1q720bd" />
    <bpmn:sendTask id="Task_QueryUnblocked" name="Query Task Dependency Graph for unblocked tasks">
      <bpmn:incoming>Flow_TA1</bpmn:incoming>
      <bpmn:outgoing>Flow_TA2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveUnblocked" name="Receive unblocked task list">
      <bpmn:incoming>Flow_TA2</bpmn:incoming>
      <bpmn:outgoing>Flow_TA3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TA2" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_ReadWorkerMeta" name="Read Worker&#39;s metadata from Worker Database">
      <bpmn:incoming>Flow_TA3</bpmn:incoming>
      <bpmn:outgoing>Flow_TA4</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_ReceiveWorkerMeta" name="Receive Worker metadata">
      <bpmn:incoming>Flow_TA4</bpmn:incoming>
      <bpmn:outgoing>Flow_TA5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_TA3" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FilterAndSort" name="Filter unblocked tasks by Worker capabilities; sort by priority and deadline">
      <bpmn:incoming>Flow_TA5</bpmn:incoming>
      <bpmn:outgoing>Flow_TA6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_1thh7ty" name="Check if one of the tasks is owned by this worker and is not complete">
      <bpmn:incoming>Flow_TA6</bpmn:incoming>
      <bpmn:outgoing>Flow_10lcpbq</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_0bm8tmy" name="Receive query result">
      <bpmn:incoming>Flow_10lcpbq</bpmn:incoming>
      <bpmn:outgoing>Flow_0cxch34</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0srtwm9" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_RecordAssignment" name="Conditional write: record assigned task in Worker Database WHERE state = &#39;in progress&#39;">
      <bpmn:incoming>Flow_AssignYes</bpmn:incoming>
      <bpmn:incoming>Flow_0xpen27</bpmn:incoming>
      <bpmn:outgoing>Flow_TA_WaitRecord</bpmn:outgoing>
    </bpmn:sendTask>
